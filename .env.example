# Локальная разработка: скопируй в .env и поправь
DATABASE_URL=postgres://finance:finance@localhost:5432/finance

# Auth (единственный пользователь, регистрация в приложении отсутствует)
AUTH_USERNAME=pike
AUTH_PASSWORD=change-me
# Длинная случайная строка для подписи cookie-сессии (openssl rand -hex 32)
SESSION_SECRET=change-me-long-random-string

# Пароль postgres в docker-compose
POSTGRES_PASSWORD=finance

# Secure-cookie: true за HTTPS (Cloudflare/прод), false для локального http
COOKIE_SECURE=false
